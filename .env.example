# Database
POSTGRES_DB=donutshop
POSTGRES_USER=donutshop
POSTGRES_PASSWORD=changeme_strong_password

# Backend
DATABASE_URL=postgres://donutshop:changeme_strong_password@postgres:5432/donutshop?sslmode=disable
JWT_SECRET=changeme_jwt_secret_min_32_chars_long
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=720h
PORT=8080
BASE_URL=http://localhost

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api/v1

# S3-compatible storage (Cloudflare R2, MinIO, AWS S3)
# Leave blank to fall back to local disk under ./uploads/
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_BASE_URL=

# Optional: Midtrans (QRIS, disabled by default)
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_ENV=sandbox
