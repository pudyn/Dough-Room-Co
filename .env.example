# ============================================================
# Template konfigurasi Doughroom POS
#
# LOKAL (docker-compose.yml):
#   docker compose up -d --build
#   (untuk lokal, semua nilai sudah diatur di docker-compose.yml —
#    file ini tidak wajib diisi)
#
# SERVER (docker-compose.prod.yml):
#   cp .env.example .env
#   nano .env     # isi DB_PASSWORD & JWT_SECRET (WAJIB), cek domain & port
#   docker compose -f docker-compose.prod.yml up -d --build
#
# File .env TIDAK ikut ke GitHub (aman menyimpan password di situ).
# ============================================================

# ==== Database (PostgreSQL) ====
# Di SERVER: host.docker.internal otomatis menunjuk ke server tempat Docker jalan.
# Kalau PostgreSQL ada di mesin LAIN, ganti dengan IP/hostname mesin itu.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=donutshop
DB_PASSWORD=ganti_password_db_yang_kuat
DB_NAME=donutshop
DB_SSLMODE=disable

# ==== Backend ====
# WAJIB diganti untuk production! Buat string acak di server:
#   openssl rand -base64 48
JWT_SECRET=ganti_string_acak_minimal_32_karakter
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=336h
TIMEZONE=Asia/Jakarta
SERVER_PORT=8080

# URL publik situs (dipakai untuk link QR code)
FRONTEND_URL=https://doughroomco.my.id

# ==== Web (frontend) ====
# 8081 = default: port 80 di server sudah dipakai nginx/Certbot
#        (arahkan reverse proxy domain ke 127.0.0.1:8081)
# 80   = kalau server tidak punya nginx sendiri
WEB_PORT=8081

# ==== Storage foto (opsional) ====
# Kosongkan saja untuk menyimpan foto di disk server (volume Docker, permanen).
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_BASE_URL=

# ==== Midtrans / QRIS (opsional, nonaktif default) ====
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_ENV=sandbox
