# ============================================================
# Contoh konfigurasi untuk SERVER (production).
# Salin jadi .env.production lalu isi nilai aslinya:
#   cp .env.production.example .env.production
# File .env.production TIDAK ikut ke GitHub (rahasia).
# ============================================================

# ==== Database (PostgreSQL di server/VM, bukan di Docker) ====
# host.docker.internal = otomatis menunjuk ke server tempat Docker berjalan.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=donutshop
DB_PASSWORD=ganti_password_db_yang_kuat_di_sini
DB_NAME=donutshop
DB_SSLMODE=disable

# ==== Backend ====
# WAJIB diganti! Buat string acak panjang, contoh di server:
#   openssl rand -base64 48
JWT_SECRET=ganti_string_acak_minimal_32_karakter
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=336h
TIMEZONE=Asia/Jakarta

# URL publik situs (dipakai untuk link QR code)
FRONTEND_URL=https://doughroomco.my.id

# ==== Web ====
# 8081 = default: port 80 di server dipakai nginx/Certbot → arahkan
#        reverse proxy domain ke 127.0.0.1:8081
# 80   = kalau server tidak punya nginx sendiri (frontend langsung di domain)
WEB_PORT=8081
