# ============================================================
# Contoh konfigurasi nginx SERVER (host) untuk domain doughroomco.my.id
#
# Frontend Docker jalan di 127.0.0.1:8081 (lihat docker-compose.prod.yml → WEB_PORT).
# nginx server ini yang menangani port 80/443 + HTTPS (Certbot).
#
# Cara pakai:
#   1. Salin file ini, misal: sudo cp nginx/server-domain.conf.example /etc/nginx/sites-available/doughroomco.conf
#   2. Aktifkan:  sudo ln -s /etc/nginx/sites-available/doughroomco.conf /etc/nginx/sites-enabled/
#   3. Sertifikat HTTPS (sekali saja):
#        sudo certbot --nginx -d doughroomco.my.id
#      (certbot otomatis menambahkan blok SSL & redirect)
#   4. Cek & reload:  sudo nginx -t && sudo systemctl reload nginx
# ============================================================

server {
    listen 80;
    listen [::]:80;
    server_name doughroomco.my.id;

    # Upload foto (produk / bukti transfer / review) — jangan terlalu kecil
    client_max_body_size 10M;

    location / {
        proxy_pass http://127.0.0.1:8081;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket / koneksi upgrade
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# Catatan:
# - Setelah `certbot --nginx` dijalankan, nginx otomatis menambahkan
#   server block HTTPS (listen 443 ssl) + redirect dari HTTP ke HTTPS.
# - Kalau mau manual, blok HTTPS memakai file dari Certbot:
#     ssl_certificate     /etc/letsencrypt/live/doughroomco.my.id/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/doughroomco.my.id/privkey.pem;
# - Semua path (/api, /uploads, halaman) diproxy ke satu alamat yang sama,
#   karena nginx di dalam container frontend sudah mengatur semuanya.
